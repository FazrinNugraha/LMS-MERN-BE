# ===== Wajib =====
DATABASES_URL=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority
SECRET_KEY_JWT=<random string minimal 32 karakter>
FRONTEND_URL=http://localhost:5173

# ===== Midtrans =====
# Isi salah satu saja. MIDTRANS_SERVER_KEY lebih disarankan/eksplisit.
MIDTRANS_URL=https://app.sandbox.midtrans.com/snap/v1/transactions
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxxxxxxxxxxxxxx
# MIDTRANS_AUTH_STRING=<base64 dari "SERVER_KEY:">   # opsional (kompatibilitas lama)

# ===== Cloudinary =====
CLOUDINARY_CLOUD_NAME=xxxxxxxx
CLOUDINARY_API_KEY=xxxxxxxxxxxxxxxx
CLOUDINARY_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxx

# ===== Paket / harga manager =====
# Harga (Rupiah) yang dikirim ke Midtrans saat manager mendaftar.
# Keputusan produk: SATU PAKET, SEKALI BAYAR (tanpa masa aktif / tanpa perpanjangan).
# Nilai ini harus sama dengan yang ditampilkan di halaman Pricing FE (Rp 200.000).
MANAGER_PLAN_PRICE=200000

# ===== Lain-lain =====
NODE_ENV=development
# CATATAN: JANGAN set NODE_ENV=development di Environment Variables Vercel (production),
# karena index.js akan ikut menjalankan app.listen() pada mode serverless.

# ===== JWT hardening (opsional / opt-in) =====
# Kalau JWT_ISSUER / JWT_AUDIENCE diset, token BARU memakai klaim itu dan verifyToken
# akan menolak token tanpa klaim yang cocok. Selama belum diset, perilaku lama dipakai
# supaya token yang sudah beredar tidak langsung mati.
# Rekomendasi: set ini BERSAMAAN dengan rotasi SECRET_KEY_JWT (semua user login ulang).
# JWT_ALGORITHMS=HS256
# JWT_ISSUER=lms-backend
# JWT_AUDIENCE=lms-frontend
